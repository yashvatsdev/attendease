{
  "name": "attendease",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-db.ps1",
    "db:setup": "node scripts/database.mjs setup",
    "db:seed": "node scripts/database.mjs seed",
    "db:check": "node scripts/database.mjs check",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "node scripts/api-test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "format": "prettier --write app components lib scripts tests database/*.sql README.md docs/*.md *.json *.mjs *.ts --ignore-unknown",
    "diagram:er": "node scripts/generate-er-diagram.mjs",
    "db:cloud:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-cloud-db.ps1",
    "db:cloud:setup": "node scripts/cloud-database.mjs setup",
    "db:cloud:seed": "node scripts/cloud-database.mjs seed",
    "db:cloud:check": "node scripts/cloud-database.mjs check",
    "vercel:env:push": "node scripts/push-cloud-env.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.1",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.60.0",
    "mysql2": "^3.24.6",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "mermaid": "^12.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
